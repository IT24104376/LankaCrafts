# LankaCrafts Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
# Replace with your MongoDB connection string
MONGO_URI=mongodb://localhost:27017/lankacrafts

# Firebase Configuration
# Get these from your Firebase Project Settings > General > Your apps
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# PayHere Payment Gateway
# Get these from your PayHere merchant dashboard
# IMPORTANT: These must be set in production!
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
# Set to 'live' for production, leave empty for sandbox
PAYHERE_MODE=

# Frontend URL (for payment redirects)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Session/JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production